{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-mini-app-3250/dev/types/**/*.ts",
    ".next-3250/types/**/*.ts",
    ".next-3250/dev/types/**/*.ts",
    ".next-deploy-vinclub/types/**/*.ts",
    ".next-deploy-vinclub/dev/types/**/*.ts",
    ".next-dev-3250/types/**/*.ts",
    ".next-dev-3250/dev/types/**/*.ts",
    ".next-3300/types/**/*.ts",
    ".next-3300/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "figma-plugin"
  ]
}
