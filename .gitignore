# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/worktrees/
.playwright-mcp/

# root-level screenshots (debug/reference only, not for deploy)
/*.png

# Render outputs / heavy assets (kept local, not in git)
/output/
/blender/
/Ref/
**/node_modules/
/public/vinclub-film-v6.mp4
/public/vinclub-film-v8.mp4
/public/vinclub-film-v9.mp4
